{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "communityName": {
            "type": "string"
        },
        "apiVersion": {
            "defaultValue": "2024-01-01-preview",
            "type": "string"
        },
        "addressSpace": {
            "defaultValue": "10.0.0.0/16",
            "type": "string"
        },
        "dnsServers": {
            "defaultValue": [],
            "type": "array"
        },
        "location": {
            "defaultValue": "[resourceGroup().location]",
            "type": "string"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Mission/communities",
            "apiVersion": "[parameters('apiVersion')]",
            "name": "[parameters('communityName')]",
            "location": "[parameters('location')]",
            "tags": {
                "department": "MyDepartment",
                "company": "MyCompany"
            },
            "properties": {
                "addressSpace": "[parameters('addressSpace')]",
                "dnsServers": "[parameters('dnsServers')]"
            }
        },
        {
            "type": "Microsoft.Mission/communities/transitHubs",
            "apiVersion": "[parameters('apiVersion')]",
            "name": "[format('{0}/{1}', parameters('communityName'), 'transit-hub-1')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Mission/communities', parameters('communityName'))]"
            ],
            "tags": {
                "department": "MyDepartment",
                "company": "MyCompany"
            },
            "properties": {
                "transitOption": {
                    "type": "ExpressRoute",
                    "params": {
                        "scaleUnits": 2
                    }
                }
            }
        },
        {
            "type": "Microsoft.Mission/communities/communityEndpoints",
            "apiVersion": "[parameters('apiVersion')]",
            "name": "[concat(parameters('communityName'), '/example')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Mission/communities', parameters('communityName'))]",
                "[resourceId('Microsoft.Mission/communities/transitHubs', parameters('communityName'), 'transit-hub-1')]"
            ],
            "tags": {
                "department": "MyDepartment",
                "company": "MyCompany"
            },
            "properties": {
                "ruleCollection": [
                    {
                        "name": "example-dataplane",
                        "destinationType": "PrivateNetwork",
                        "destination": "172.16.0.0/20",
                        "protocols": [ "TCP", "UDP" ],
                        "port": "443,80,3389,53",
                        "transitHubResourceId": "[resourceId('Microsoft.Mission/communities/transitHubs', parameters('communityName'), 'transit-hub-1')]"
                    },
                    {
                        "name": "example-vpaw",
                        "destinationType": "PrivateNetwork",
                        "destination": "172.16.40.0/23",
                        "protocols": [ "TCP", "UDP" ],
                        "port": "443,80,3389",
                        "transitHubResourceId": "[resourceId('Microsoft.Mission/communities/transitHubs', parameters('communityName'), 'transit-hub-1')]"
                    }
                ]
            }
        },
        {
            "type": "Microsoft.Mission/communities/communityEndpoints",
            "apiVersion": "[parameters('apiVersion')]",
            "name": "[concat(parameters('communityName'), '/trustedMsftSites')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Mission/communities', parameters('communityName'))]",
                "[resourceId('Microsoft.Mission/communities/transitHubs', parameters('communityName'), 'transit-hub-1')]"
            ],
            "tags": {
                "department": "MyDepartment",
                "company": "MyCompany"
            },
            "properties": {
                "ruleCollection": [
                    {
                        "name": "bing",
                        "destinationType": "FQDN",
                        "destination": "bing.com, *.bing.com",
                        "protocols": [ "HTTPS" ],
                        "port": "443"
                    },
                    {
                        "name": "outlook",
                        "destinationType": "FQDN",
                        "destination": "outlook.com, *.outlook.com, *outlook.live.com",
                        "protocols": [ "HTTPS" ],
                        "port": "443"
                    }
                ]
            }
        }
    ],
    "outputs": {
        "communityResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Mission/communities', parameters('communityName'))]"
        },
        "communityAddressSpace": {
            "type": "string",
            "value": "[parameters('addressSpace')]"
        },
        "communityEndpointExampleResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Mission/communities/communityEndpoints', parameters('communityName'), 'example')]"
        },
        "communityEndpointMsftTrustedSitesResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Mission/communities/communityEndpoints', parameters('communityName'), 'trustedMsftSites')]"
        }
    }
}
